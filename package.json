{
  "name": "word-panda",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "node --env-file=.env scripts/seed.mjs",
    "migrate:family-slugs": "node --env-file=.env scripts/migrate-family-slugs.mjs",
    "fix:unterstellen": "node --env-file=.env scripts/fix-unterstellen.mjs"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "mongoose": "^9.9.1",
    "nuxt": "^4.5.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.9"
  }
}
